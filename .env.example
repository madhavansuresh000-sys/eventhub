# Copy this file to .env and choose your own passwords.
# .env is in .gitignore, so your real passwords never go to GitHub.
MYSQL_USER=eventhub
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Phase 5 (security)
# Key that signs login tokens. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-64-random-hex-characters
# Password for the demo accounts created in dev (leave empty to create none)
DEMO_PASSWORD=change-me
